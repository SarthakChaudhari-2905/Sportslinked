import { useEffect, useState } from "react";
import { useSearchParams, Link } from "react-router-dom";
import { Search, MapPin, Users, Sparkles } from "lucide-react";
import { athleteProfileApi } from "../../lib/endpoints";
import { Card, Input, Select, Avatar, Badge, EmptyState, PageSpinner, Button, titleCase } from "../../components/ui";

const LEVELS = ["", "BEGINNER", "AMATEUR", "SCHOOL", "COLLEGE", "DISTRICT", "STATE", "NATIONAL", "INTERNATIONAL", "PROFESSIONAL"];

const QUICK_SPORTS = ["Football", "Cricket", "Basketball", "Tennis", "Badminton", "Athletics", "Hockey"];

export default function AthleteDiscovery() {
  const [params, setParams] = useSearchParams();
  const [sport, setSport] = useState(params.get("sport") || "");
  const [level, setLevel] = useState(params.get("level") || "");
  const [city, setCity] = useState(params.get("city") || "");
  const [athletes, setAthletes] = useState(null);
  const [loading, setLoading] = useState(true);

  const runSearch = async (e, overrides = {}) => {
    e?.preventDefault();
    setLoading(true);
    const query = {};
    const nextSport = overrides.sport ?? sport;
    if (nextSport) query.sport = nextSport;
    if (level) query.level = level;
    if (city) query.city = city;
    setParams(query);
    try {
      const data = await athleteProfileApi.search(query);
      setAthletes(data?.profiles || data?.athletes || data || []);
    } catch {
      setAthletes([]);
    } finally {
      setLoading(false);
    }
  };

  const handleQuickSport = (value) => {
    setSport(value);
    runSearch(null, { sport: value });
  };

  useEffect(() => {
    runSearch();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div>
      {/* Hero header */}
      <div className="hero-grid relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-brand-900 px-6 py-8 text-white sm:px-10 sm:py-10">
        <div className="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-500/20 blur-3xl" />
        <div className="pointer-events-none absolute -bottom-20 left-1/3 h-56 w-56 rounded-full bg-indigo-500/20 blur-3xl" />
        <div className="relative flex items-center gap-2 text-brand-200">
          <Sparkles size={16} />
          <span className="text-xs font-bold uppercase tracking-widest">Talent discovery</span>
        </div>
        <h1 className="relative mt-2 text-2xl font-extrabold sm:text-3xl">Discover athletes</h1>
        <p className="relative mt-1.5 max-w-lg text-sm text-slate-300">
          Search verified athlete profiles by sport, level and location - and reach out directly.
        </p>

        <div className="relative mt-5 flex flex-wrap gap-2">
          {QUICK_SPORTS.map((s) => (
            <button
              key={s}
              type="button"
              onClick={() => handleQuickSport(s.toLowerCase())}
              className={`rounded-full border px-3.5 py-1.5 text-xs font-semibold transition ${
                sport.toLowerCase() === s.toLowerCase()
                  ? "border-white bg-white text-slate-900"
                  : "border-white/25 bg-white/5 text-white hover:bg-white/15"
              }`}
            >
              {s}
            </button>
          ))}
        </div>
      </div>

      {/* Search filters */}
      <Card className="relative z-10 -mt-5 mx-2 p-4 shadow-lg sm:mx-6">
        <form onSubmit={runSearch} className="grid gap-3 sm:grid-cols-4">
          <div className="relative">
            <Search size={15} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <Input
              placeholder="Sport, e.g. football"
              value={sport}
              onChange={(e) => setSport(e.target.value)}
              className="pl-9"
            />
          </div>
          <Select value={level} onChange={(e) => setLevel(e.target.value)}>
            {LEVELS.map((l) => (
              <option key={l} value={l}>
                {l ? titleCase(l) : "Any level"}
              </option>
            ))}
          </Select>
          <div className="relative">
            <MapPin size={15} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <Input placeholder="City" value={city} onChange={(e) => setCity(e.target.value)} className="pl-9" />
          </div>
          <Button type="submit">
            <Search size={16} /> Search
          </Button>
        </form>
      </Card>

      <div className="mt-6">
        {loading ? (
          <PageSpinner label="Searching athletes..." />
        ) : athletes.length === 0 ? (
          <EmptyState
            icon={Users}
            title="No athletes found"
            description="Try a different sport, level or location - or clear the filters to see everyone."
          />
        ) : (
          <>
            <p className="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
              {athletes.length} athlete{athletes.length === 1 ? "" : "s"} found
            </p>
            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {athletes.map((p) => {
                const u = p.user || {};
                const name = `${u.firstName || ""} ${u.lastName || ""}`.trim() || u.username;
                return (
                  <Link
                    key={p._id}
                    to={`/athletes/${u._id}`}
                    className="card card-hover group relative overflow-hidden p-4"
                  >
                    <div className="absolute inset-x-0 top-0 h-14 bg-gradient-to-r from-brand-600 to-indigo-600 opacity-90" />
                    <div className="relative flex items-center gap-3 pt-3">
                      <div className="rounded-full ring-4 ring-white">
                        <Avatar name={name} src={u.avatar} size={52} />
                      </div>
                      <div className="min-w-0">
                        <p className="truncate text-sm font-bold text-slate-800">{name}</p>
                        <p className="truncate text-xs text-slate-500">
                          {titleCase(p.primarySport)} {p.position ? `- ${titleCase(p.position)}` : ""}
                        </p>
                      </div>
                    </div>
                    <div className="relative mt-3.5 flex flex-wrap items-center gap-1.5">
                      <Badge tone="brand">{titleCase(p.playingLevel)}</Badge>
                      {p.location?.city && (
                        <span className="flex items-center gap-1 text-xs text-slate-400">
                          <MapPin size={11} /> {p.location.city}
                        </span>
                      )}
                    </div>
                  </Link>
                );
              })}
            </div>
          </>
        )}
      </div>
    </div>
  );
}

