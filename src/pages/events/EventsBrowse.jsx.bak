import { useEffect, useState } from "react";
import { Link, useSearchParams } from "react-router-dom";
import { Search, MapPin, CalendarDays, Plus, Trophy } from "lucide-react";
import { useAuth } from "../../context/AuthContext";
import { eventApi } from "../../lib/endpoints";
import { Card, Input, Select, Badge, EmptyState, PageSpinner, Button, formatDate, titleCase } from "../../components/ui";

const EVENT_TYPES = ["", "MATCH", "TRIAL", "TOURNAMENT", "TRAINING", "CAMP", "SCOUTING_SESSION", "OTHER"];
const ORG_ROLES = ["CLUB", "ACADEMY", "AGENCY"];

const QUICK_TYPES = ["TRIAL", "TOURNAMENT", "MATCH", "CAMP"];

const TYPE_ACCENTS = {
  MATCH: "from-rose-500 to-orange-500",
  TRIAL: "from-brand-500 to-indigo-600",
  TOURNAMENT: "from-amber-500 to-rose-500",
  TRAINING: "from-emerald-500 to-teal-600",
  CAMP: "from-indigo-500 to-purple-600",
  SCOUTING_SESSION: "from-cyan-500 to-brand-600",
  OTHER: "from-slate-500 to-slate-700",
};

export default function EventsBrowse() {
  const { user } = useAuth();
  const [params, setParams] = useSearchParams();
  const [sport, setSport] = useState(params.get("sport") || "");
  const [type, setType] = useState(params.get("type") || "");
  const [city, setCity] = useState(params.get("city") || "");
  const [events, setEvents] = useState(null);
  const [loading, setLoading] = useState(true);
  const isOrg = ORG_ROLES.includes(user?.role);

  const runSearch = async (e, overrides = {}) => {
    e?.preventDefault();
    setLoading(true);
    const nextType = overrides.type ?? type;
    const query = { status: "PUBLISHED" };
    if (sport) query.sport = sport;
    if (nextType) query.type = nextType;
    if (city) query.city = city;
    setParams({ sport, type: nextType, city });
    try {
      const data = await eventApi.browse(query);
      setEvents(data?.events || data || []);
    } catch {
      setEvents([]);
    } finally {
      setLoading(false);
    }
  };

  const handleQuickType = (value) => {
    const next = type === value ? "" : value;
    setType(next);
    runSearch(null, { type: next });
  };

  useEffect(() => {
    runSearch();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div>
      {/* Hero header */}
      <div className="hero-grid relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-brand-900 px-6 py-8 text-white sm:px-10 sm:py-10">
        <div className="pointer-events-none absolute -right-20 -top-16 h-60 w-60 rounded-full bg-amber-400/15 blur-3xl" />
        <div className="pointer-events-none absolute -bottom-20 left-1/4 h-56 w-56 rounded-full bg-brand-500/20 blur-3xl" />

        <div className="relative flex flex-wrap items-start justify-between gap-4">
          <div>
            <div className="flex items-center gap-2 text-brand-200">
              <Trophy size={16} />
              <span className="text-xs font-bold uppercase tracking-widest">Live opportunities</span>
            </div>
            <h1 className="mt-2 text-2xl font-extrabold sm:text-3xl">Browse opportunities</h1>
            <p className="mt-1.5 max-w-lg text-sm text-slate-300">
              Trials, matches, camps and tournaments from verified organizations.
            </p>
          </div>
          {isOrg && (
            <Link to="/events/new" className="btn-primary shrink-0 bg-white text-slate-900 hover:bg-slate-100">
              <Plus size={16} /> Post event
            </Link>
          )}
        </div>

        <div className="relative mt-5 flex flex-wrap gap-2">
          {QUICK_TYPES.map((t) => (
            <button
              key={t}
              type="button"
              onClick={() => handleQuickType(t)}
              className={`rounded-full border px-3.5 py-1.5 text-xs font-semibold transition ${
                type === t
                  ? "border-white bg-white text-slate-900"
                  : "border-white/25 bg-white/5 text-white hover:bg-white/15"
              }`}
            >
              {titleCase(t)}
            </button>
          ))}
        </div>
      </div>

      {/* Search filters */}
      <Card className="relative z-10 -mt-5 mx-2 p-4 shadow-lg sm:mx-6">
        <form onSubmit={runSearch} className="grid gap-3 sm:grid-cols-4">
          <div className="relative">
            <Search size={15} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <Input placeholder="Sport" value={sport} onChange={(e) => setSport(e.target.value)} className="pl-9" />
          </div>
          <Select value={type} onChange={(e) => setType(e.target.value)}>
            {EVENT_TYPES.map((t) => (
              <option key={t} value={t}>
                {t ? titleCase(t) : "Any type"}
              </option>
            ))}
          </Select>
          <div className="relative">
            <MapPin size={15} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <Input placeholder="City" value={city} onChange={(e) => setCity(e.target.value)} className="pl-9" />
          </div>
          <Button type="submit">
            <Search size={16} /> Search
          </Button>
        </form>
      </Card>

      <div className="mt-6">
        {loading ? (
          <PageSpinner label="Loading events..." />
        ) : events.length === 0 ? (
          <EmptyState icon={CalendarDays} title="No events found" description="Try different filters or check back soon." />
        ) : (
          <>
            <p className="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
              {events.length} opportunit{events.length === 1 ? "y" : "ies"} live
            </p>
            <div className="grid gap-4 sm:grid-cols-2">
              {events.map((ev) => (
                <Link
                  key={ev._id}
                  to={`/events/${ev._id}`}
                  className="card card-hover group relative overflow-hidden p-4 pl-5"
                >
                  <div
                    className={`absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b ${
                      TYPE_ACCENTS[ev.type] || TYPE_ACCENTS.OTHER
                    }`}
                  />
                  <div className="flex items-start justify-between gap-2">
                    <p className="text-sm font-bold text-slate-800">{ev.title}</p>
                    <Badge tone="brand">{titleCase(ev.type)}</Badge>
                  </div>
                  <p className="mt-1 text-xs font-medium text-slate-500">{titleCase(ev.sport)}</p>
                  <div className="mt-3.5 flex items-center justify-between text-xs text-slate-400">
                    <span className="flex items-center gap-1 rounded-full bg-slate-50 px-2 py-1 font-medium text-slate-600">
                      <CalendarDays size={12} /> {formatDate(ev.startDate)}
                    </span>
                    {ev.location?.city && (
                      <span className="flex items-center gap-1">
                        <MapPin size={12} /> {ev.location.city}
                      </span>
                    )}
                  </div>
                </Link>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  );
}

